# ===========================================
# Chatbot GLPI - Environment Variables
# ===========================================
# Copy this file to .env and configure your values

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# Evolution API (WhatsApp Integration)
EVOLUTION_API_URL=https://your-evolution-api.com
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_API_INSTANCE=your_instance_name

# GLPI API (Ticket System)
GLPI_API_URL=https://your-glpi.com/apirest.php
GLPI_API_APP_TOKEN=your_glpi_app_token
GLPI_API_USER_TOKEN=your_glpi_user_token
